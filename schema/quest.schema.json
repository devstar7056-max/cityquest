{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityquest.local/quest.schema.json",
  "title": "CityQuest quest",
  "description": "What the World Director (gemini-4-argon) returns. The verifier fills route and verification; the Director never writes them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["quest_id", "generated_at", "request", "title", "theme", "deadline_min", "start", "end", "stops"],
  "properties": {
    "quest_id": {"type": "string", "description": "q- plus a short id"},
    "parent_quest_id": {"type": ["string", "null"], "description": "Replans only: the quest this one changes."},
    "generated_at": {"type": "string", "format": "date-time"},
    "request": {"type": "string", "description": "The person's words, verbatim."},
    "title": {"type": "string", "maxLength": 40},
    "theme": {"type": "string", "maxLength": 80},
    "deadline_min": {"type": "integer", "minimum": 5, "maximum": 180},
    "change_note": {"type": ["string", "null"], "maxLength": 200, "description": "Replans only: one sentence on what changed and why."},
    "start": {"$ref": "#/$defs/point"},
    "end": {"$ref": "#/$defs/point"},
    "stops": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/stop"}},
    "route": {"$ref": "#/$defs/route"},
    "verification": {"$ref": "#/$defs/verification"}
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "place_id": {"type": ["string", "null"]},
        "lat": {"type": ["number", "null"]},
        "lng": {"type": ["number", "null"]}
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "place_id", "name", "objective", "reward", "dwell_min"],
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]+$"},
        "place_id": {"type": "string", "description": "Must exist in data/merchants.json."},
        "name": {"type": "string"},
        "unit": {"type": ["string", "null"], "description": "Ferry Building unit from the official map."},
        "category": {"type": ["string", "null"]},
        "lat": {"type": ["number", "null"]},
        "lng": {"type": ["number", "null"]},
        "objective": {"type": "string", "maxLength": 120, "description": "One playful thing the person can actually do there. No invented facts."},
        "why": {"type": ["string", "null"], "maxLength": 120, "description": "Why it fits their request."},
        "dwell_min": {"type": "integer", "minimum": 1, "maximum": 60},
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sprite", "points"],
          "properties": {
            "sprite": {"enum": ["coffee", "tea", "icecream", "chocolate", "pastry", "bread", "oyster", "book", "ceramics", "clocktower", "pier", "ferry", "wine", "beer", "star"]},
            "points": {"type": "integer", "minimum": 5, "maximum": 100}
          }
        },
        "source": {"enum": ["director", "swap"], "description": "swap means the verifier put it in."}
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "encoded_polyline": {"type": ["string", "null"]},
        "distance_m": {"type": ["number", "null"]},
        "walk_min_total": {"type": ["number", "null"]},
        "legs": {"type": "array"}
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {"enum": ["pending", "pass", "fixed", "fail", "error"]},
        "path": {"enum": ["managed_agent", "local_fallback"]},
        "checked_at": {"type": "string"},
        "total_min": {"type": "number"},
        "back_by": {"type": "string"},
        "timeline": {"type": "array"},
        "checks": {"type": "array"},
        "swaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "removed": {"type": "string"},
              "added": {"type": ["string", "null"]},
              "reason": {"type": "string"}
            }
          }
        },
        "log": {"type": "array", "description": "Commands the managed agent ran, each with its exit code and a one-line result."}
      }
    }
  }
}
